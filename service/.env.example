# Production uses PostgreSQL whenever DATABASE_URL is present.
DATABASE_URL=postgresql://user:password@host:5432/vegfinder
MENU_CHECK_INTERVAL_HOURS=24
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
# Where menu-review alerts are delivered. Accepts a Slack or Discord incoming
# webhook, or any endpoint that accepts a JSON POST. Without it, a demoted
# restaurant is recorded but nobody is told.
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/your-webhook
# Which extraction tiers may publish without human review. Defaults to
# fully_vegan (operator-declared whole-menu vegan restaurants). Add
# labelled_menu to trust menus that publish their own dietary legend, or set it
# empty to make everything a reviewable proposal.
AUTO_PUBLISH_TIERS=fully_vegan
# Enables model-assisted drafting for menus that publish no dietary legend.
# Drafts always require human confirmation; they are never auto-published.
# ANTHROPIC_API_KEY=sk-ant-...
# EXTRACTION_MODEL=claude-opus-5
# How long a phone/photo/in-person verification stands before it is re-queued.
OFFLINE_REVIEW_DAYS=90
# BROWSER_EXECUTABLE=/usr/bin/chromium
